{
  "name": "Teekhi_Nazaar",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.3",
      "varlock": "1.23.0",
      "better-auth": "1.7.12",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "1.0.0-rc.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @Teekhi_Nazaar/db --",
    "db:studio": "turbo run db:studio -F @Teekhi_Nazaar/db --",
    "db:generate": "turbo run db:generate -F @Teekhi_Nazaar/db --",
    "db:migrate": "turbo run db:migrate -F @Teekhi_Nazaar/db --",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/server && bun run auth:generate"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@Teekhi_Nazaar/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2"
  },
  "packageManager": "bun@1.3.14"
}
