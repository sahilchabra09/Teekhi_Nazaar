# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Google OAuth client (docs/google.md). Leave empty to disable Google sign-in.
# The client ID is public by design (it appears in every Google sign-in URL); the secret is not.
# @optional @public
GOOGLE_CLIENT_ID=

# @optional
GOOGLE_CLIENT_SECRET=

# ── Talk (docs/talk.md) ────────────────────────────────────────────
# OpenRouter key for speech-to-text + reply suggestions. Without it, /api/talk/* answers 503.
# @optional
OPENROUTER_API_KEY=

# Model IDs are not secrets.
# @public
OPENROUTER_REPLY_MODEL=z-ai/glm-5.3-flash
# @public
OPENROUTER_REPLY_FALLBACK_MODEL=deepseek/deepseek-v4-flash
# @public
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
# @public
OPENROUTER_STT_FALLBACK_MODEL=openai/whisper-large-v3

# ── AutoSage: patient knowledge bases + reply chats (docs/care.md) ─────────
# API key (sk_live_… / sk_test_…). Without it records stay "pending" and replies fall back to OpenRouter.
# @optional
AUTOSAGE_API_KEY=
# @public
AUTOSAGE_BASE_URL=https://beta-api.autosage.ai
# Tenant holding every patient's knowledge base. Empty → find or create the tenant with external_id "iris".
# @optional @public
AUTOSAGE_TENANT_ID=
# Model for /chats/fast-query (any id from GET /chats/models). Benchmarked 2026-11-04 on the reply
# prompt: deepseek-v4.1-flash 2.3 s (cheapest), claude-haiku-4.5 2.4 s, gemini-3.5-flash-lite 2.4 s,
# gpt-6-luna 4.7 s, glm-5.3-flash 16 s (reasoning can't be turned off through AutoSage).
# @public
AUTOSAGE_MODEL=deepseek/deepseek-v4.1-flash
